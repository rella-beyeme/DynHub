# ==========================================================================
# HUB DYNEFF — configuration du serveur
# Copiez ce fichier en « .env » à la racine du hub et remplissez les valeurs.
# Ne partagez jamais le fichier .env : il contient des secrets.
# ==========================================================================

# --- Serveur ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Adresse publique du hub, telle que tapée dans le navigateur (sans / final)
URL_PUBLIQUE=https://hub.dyneff.fr
# « oui » si le hub est derrière un proxy inverse (IIS, nginx) qui gère le HTTPS
DERRIERE_PROXY=oui

# --- Connexion Microsoft (Entra ID) ---------------------------------------
# entra = comptes Microsoft Dyneff | demo = comptes de test (jamais en production)
MODE_CONNEXION=entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=a-remplacer
# Durée d'une session avant reconnexion (heures)
DUREE_SESSION_HEURES=10

# Clé secrète des cookies de session : 64 caractères aléatoires. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRET_SESSION=a-remplacer-par-une-longue-valeur-aleatoire

# --- Droits ----------------------------------------------------------------
# Administrateurs permanents (e-mails Microsoft, séparés par des virgules).
# Ils peuvent tout modifier et nommer les autres modificateurs dans la page.
ADMINS=cellulemp@dyneff.fr

# --- Fichiers --------------------------------------------------------------
# Taille maximale d'un document envoyé (Mo) — pensez aux vidéos
TAILLE_MAX_MO=500
# Emplacements (relatifs au dossier du hub, ou chemins absolus)
DOSSIER_DONNEES=data
DOSSIER_DOCUMENTS=documents
DOSSIER_IMAGES=images

# Liens « Bureau » acceptés en plus de ms-*, msteams, onenote, mailto
# (ex. si la DSI déploie des liens personnalisés : dynword,dynexcel)
SCHEMAS_BUREAU=

# --- Mode démonstration (MODE_CONNEXION=demo uniquement) -------------------
# email:Nom affiché, séparés par des virgules
COMPTES_DEMO=
