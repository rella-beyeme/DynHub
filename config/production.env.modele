# ==========================================================================
# HUB DYNEFF — configuration du serveur de PRODUCTION
# Copiez ce fichier en « .env » à la racine du hub et remplissez les valeurs.
# Ne partagez jamais le fichier .env : il contient des secrets.
# Détails : docs/INSTALLATION-DSI.md
# ==========================================================================
CONFIG_VERSION=2

# --- Serveur ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Adresse du hub telle que tapée dans le navigateur (sans / final).
# Utilisez le nom court ou le FQDN interne : il doit être dans la zone
# « Intranet local » des navigateurs pour que le SSO soit silencieux.
URL_PUBLIQUE=https://hub.dynfr.local
# « oui » si le hub est derrière un proxy inverse (IIS, nginx) qui gère le HTTPS.
# Attention : le proxy doit laisser passer l'en-tête Authorization (Negotiate).
DERRIERE_PROXY=non

# --- Connexion Active Directory --------------------------------------------
# windows = SSO (Negotiate : Kerberos / NTLM) — le serveur DOIT être Windows
#           et membre du domaine
# ldap    = formulaire identifiant / mot de passe Windows vérifié sur l'AD
# demo    = comptes de test (jamais en production)
MODE_CONNEXION=windows
# Domaines Windows acceptés (noms courts NetBIOS, séparés par des virgules)
DOMAINES_AUTORISES=DYNFR
# oui = NTLM uniquement (aucun SPN à déclarer) ; non = Kerberos puis NTLM
# (recommandé en production, nécessite un SPN HTTP/<nom du serveur>)
FORCER_NTLM=non
# Durée pendant laquelle les groupes AD d'un utilisateur sont gardés en mémoire
GROUPES_DUREE_HEURES=4
# Durée d'une session avant reconnexion silencieuse (heures)
DUREE_SESSION_HEURES=10

# Clé secrète des cookies de session : 64 caractères aléatoires. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRET_SESSION=a-remplacer-par-une-longue-valeur-aleatoire

# --- Administrateurs du hub --------------------------------------------------
# Comptes (DOMAINE\login), groupes AD (groupe:NOM_DU_GROUPE) ou e-mails,
# séparés par des virgules. Ils peuvent tout modifier et attribuer les droits.
ADMINS="groupe:GG_Hub_Admins, DYNFR\rella-beyeme"

# --- Annuaire LDAP -----------------------------------------------------------
# Obligatoire en MODE_CONNEXION=ldap. En mode windows, le compte de service
# permet de chercher personnes et groupes dans l'écran des droits même si le
# serveur n'est pas membre du domaine, et de relire les groupes à l'expiration.
# LDAPS (636) recommandé : le mot de passe ne circule jamais en clair.
LDAP_URL=ldaps://dc01.dynfr.local:636
LDAP_DOMAINE=DYNFR
# Vide = détecté automatiquement (defaultNamingContext)
LDAP_BASE_DN=
# Compte de service en LECTURE SEULE (ex. DYNFR\svc-hub)
LDAP_COMPTE_SERVICE=
LDAP_MOT_DE_PASSE_SERVICE=
# oui uniquement si le certificat du contrôleur n'est pas reconnu (test)
LDAP_TLS_NON_VERIFIE=non
LDAP_DELAI_MS=8000

# --- Fichiers --------------------------------------------------------------
# Taille maximale d'un document envoyé (Mo) — pensez aux vidéos
TAILLE_MAX_MO=500
# Emplacements (relatifs au dossier du hub, ou chemins absolus)
DOSSIER_DONNEES=data
DOSSIER_DOCUMENTS=documents
DOSSIER_IMAGES=images

# Liens « Bureau » acceptés en plus de ms-*, msteams, onenote, mailto
# (ex. si la DSI déploie des liens personnalisés : dynword,dynexcel)
SCHEMAS_BUREAU=

# --- Mode démonstration (MODE_CONNEXION=demo uniquement) -------------------
# DOMAINE\login:Nom affiché:groupe1|groupe2, séparés par des virgules
COMPTES_DEMO=
