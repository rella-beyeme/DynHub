# ==========================================================================
# HUB DYNEFF — configuration de la VM de TEST (serveur local)
# Ce modèle est copié en « .env » par scripts\preparer-config.js au premier
# lancement de installer.bat / demarrer.bat. Modifiez ensuite le fichier .env
# puis relancez demarrer.bat.
# ==========================================================================
CONFIG_VERSION=2

NODE_ENV=development
PORT=3000
# Adresse tapée dans le navigateur. Pour ouvrir le hub depuis un autre poste
# que la VM, remplacez localhost par le nom de la VM (ex. http://DYNMPL063:3000)
URL_PUBLIQUE=http://localhost:3000

# --- Connexion Active Directory ------------------------------------------------
# windows = SSO : la session Windows suffit, aucune saisie (VM membre du domaine)
# ldap    = formulaire identifiant / mot de passe Windows vérifié sur l'AD
# demo    = comptes de test sans Active Directory (pour essayer les droits)
MODE_CONNEXION=windows
# Domaines Windows acceptés (évite les comptes locaux de la VM)
DOMAINES_AUTORISES=DYNFR
# NTLM forcé : plus simple pour un test (Kerberos demande un SPN, voir la doc)
FORCER_NTLM=oui

# Générée automatiquement à l'installation (ne pas partager)
SECRET_SESSION=__GENEREE_A_L_INSTALLATION__
DUREE_SESSION_HEURES=10

# --- Administrateurs du hub ------------------------------------------------------
# Comptes Windows (DOMAINE\login), groupes AD (groupe:NOM) ou e-mails, séparés
# par des virgules. Vérifiez votre identifiant avec la commande « whoami ».
ADMINS="DYNFR\rella-beyeme, cellulemp@dyneff.fr"

# --- Annuaire LDAP (facultatif) ------------------------------------------------
# Sert au formulaire de secours si le SSO échoue, et à la recherche de personnes
# et de groupes dans l'écran des droits (compte de service en lecture seule).
LDAP_URL=
LDAP_DOMAINE=DYNFR
LDAP_BASE_DN=
LDAP_COMPTE_SERVICE=
LDAP_MOT_DE_PASSE_SERVICE=
LDAP_TLS_NON_VERIFIE=non

# --- Comptes de démonstration (MODE_CONNEXION=demo uniquement) -----------------
# DOMAINE\login:Nom affiché:groupe1|groupe2 — séparés par des virgules
COMPTES_DEMO="DYNFR\rella-beyeme:Administrateur du hub (vous),DYNFR\rh.test:Responsable RH (test):GG_Intranet_RH,DYNFR\cse.test:Élu CSE (test):GG_Intranet_CSE,DYNFR\tips.test:Équipe Tips (test):GG_Tips_IA,DYNFR\lecteur.test:Lecteur simple (test)"

# --- Fichiers ------------------------------------------------------------------
TAILLE_MAX_MO=500
DOSSIER_DONNEES=data
DOSSIER_DOCUMENTS=documents
DOSSIER_IMAGES=images
SCHEMAS_BUREAU=
