# ==========================================================================
# HUB DYNEFF — configuration de la VM de TEST (serveur local)
# Ce modèle est copié en « .env » par scripts\preparer-config.js au premier
# lancement de installer.bat / demarrer.bat. Modifiez ensuite le fichier .env.
# ==========================================================================

NODE_ENV=development
PORT=3000
# Adresse tapée dans le navigateur. Pour ouvrir le hub depuis un autre poste
# que la VM, remplacez localhost par le nom de la VM (ex. http://DYNMPL063:3000)
# puis redémarrez le serveur.
URL_PUBLIQUE=http://localhost:3000

# --- Connexion ---------------------------------------------------------------
# demo  = choix d'un compte de test sans Microsoft (pour essayer les droits)
# entra = vrais comptes Microsoft Dyneff (voir docs\INSTALLATION-DSI.md, étape 2)
MODE_CONNEXION=demo
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Générée automatiquement à l'installation (ne pas partager)
SECRET_SESSION=__GENEREE_A_L_INSTALLATION__
DUREE_SESSION_HEURES=10

# --- Droits --------------------------------------------------------------------
ADMINS=cellulemp@dyneff.fr

# Comptes proposés sur la page de connexion de démonstration (email:Nom)
COMPTES_DEMO="cellulemp@dyneff.fr:Cellule MP (administrateur),responsable.cse@demo.local:Responsable CSE (test),responsable.tips@demo.local:Responsable Tips (test),lecteur@demo.local:Lecteur simple (test)"

# --- Fichiers ------------------------------------------------------------------
TAILLE_MAX_MO=500
DOSSIER_DONNEES=data
DOSSIER_DOCUMENTS=documents
DOSSIER_IMAGES=images
SCHEMAS_BUREAU=
